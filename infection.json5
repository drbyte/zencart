{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "includes/classes"
        ],
        // Allow-list: everything under includes/classes is excluded except the entries named here.
        "excludes": [
            "#^(?!ResourceLoaders/|Shipping/Packing/|Settings\\.php$|TemplateDto\\.php$|TemplateSelect\\.php$|TemplateSettings\\.php$|class\\.zcPassword\\.php$|SessionHandler\\.php$|Category\\.php$|category_tree\\.php$)#"
        ]
    },
    // Mutants in TemplateResolver are covered by most tests, so their nominal run time exceeds the 10s default.
    "timeout": 120,
    "bootstrap": "not_for_release/testFramework/Support/infection-bootstrap.php",
    "phpUnit": {
        "configDir": "."
    },
    "testFrameworkOptions": "--testsuite=Infection --process-isolation",
    "logs": {
        "text": "tmp/infection/infection.log",
        "html": "tmp/infection/infection.html",
        "summary": "tmp/infection/summary.log"
    },
    "tmpDir": "tmp/infection/cache",
    "mutators": {
        "@default": true
    },
    // Measured 2026-10-21 over the whole allow-list: 87.57% (2366 mutants, 2072
    // detected). The non-packing files sit at 94%; Shipping/Packing at 72% pulls the
    // combined figure down, because row mapping and unit handling are deliberately
    // full of defensive coalescing and epsilon tolerances whose mutants are equivalent.
    // 85 leaves headroom for that kind of code while still discriminating: the same
    // allow-list before the packing test gaps were closed computes to 84.9%.
    "minMsi": 85,
    "minCoveredMsi": 85
}
